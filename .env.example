# Local SQLite file for `npm run dev` and the admin CLI (production uses Cloudflare D1)
DATABASE_PATH=purser.db
PORT=8787

# Plaid sandbox keys from https://dashboard.plaid.com (Purser refuses any env other than sandbox)
PLAID_ENV=sandbox
PLAID_CLIENT_ID=
PLAID_SECRET=
# Public URL Plaid should call, e.g. https://purser-vault.<subdomain>.workers.dev/plaid/webhook
PLAID_WEBHOOK_URL=

# 32 random bytes, base64. Dev only: production wraps data keys with a cloud KMS key.
VAULT_MASTER_KEY=

SYNC_INTERVAL_HOURS=6

# Admin CLI against production D1 instead of the local file:
# PURSER_DB=remote
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_API_TOKEN=     # needs D1: Edit
# D1_DATABASE_ID=
